{
  "compilerOptions": {
    "lib": ["es2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "noImplicitReturns": false,
    "outDir": "lib",
    "sourceMap": true,
    "target": "es2020",
    "types": ["node"],
    "strictNullChecks": true
  },
  "compileOnSave": true,
  "allowJs": true,
  "include": [
    "src/*.ts"
  ]
}
